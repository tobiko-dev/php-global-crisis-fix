{
  "name": "php-response-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Local PHP patch evidence, agency inventory, and customer handover reports.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:collector": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "experiments": "node scripts/test-hypotheses.mjs",
    "demo": "node bin/php-response.mjs demo --format html --out reports/demo.html",
    "assess": "node bin/php-response.mjs assess"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/tobiko-dev/php-global-crisis-fix.git" }
}
